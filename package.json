{
  "name": "vscode-apl",
  "displayName": "APL for VS Code",
  "version": "0.1.0",
  "description": "APL VS Code integration.",
  "author": {
    "email": "martina.alice.crippa@gmail.com",
    "name": "Martina Crippa",
    "url": "https://github.com/martanit/vscode-apl"
  },
  "license": "MIT",
  "keywords": [
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.66.0"
  },
  "icon": "images/logo.png",
  "categories": [
    "Debuggers"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/martanit/vscode-apl.git"
  },
  "bugs": {
    "url": "https://github.com/martanit/vscode-apl/issues"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
    "watch": "npm run -S esbuild-base -- --sourcemap --sources-content=false --watch",
    "build": "npm run -S esbuild-base -- --sourcemap --sources-content=false",
    "package": "vsce package",
    "vscode:prepublish": "rimraf dist && npm run -S esbuild-base -- --minify",
    "test": "npm run compile && npx mocha --ui tdd --require out/tests/helpers/register-vscode-stub.js --timeout 10000 out/tests/unit/*.test.js out/tests/integration/*.test.js",
    "test:unit": "npm run compile && npx mocha --ui tdd --require out/tests/helpers/register-vscode-stub.js out/tests/unit/*.test.js",
    "test:dyalog": "npm run compile && cross-env DYALOG_TESTS=1 npx mocha --ui tdd --require out/tests/helpers/register-vscode-stub.js --timeout 30000 out/tests/unit/*.test.js out/tests/integration/*.test.js",
    "test:e2e": "npm run build && npm run compile && vscode-test"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "^14.14.37",
    "@types/vscode": "^1.66.0",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "@vscode/debugadapter": "^1.56.0",
    "@vscode/debugadapter-testsupport": "^1.56.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "await-notify": "^1.0.1",
    "base64-js": "^1.5.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.14.29",
    "eslint": "^8.12.0",
    "events": "^3.3.0",
    "glob": "^7.2.0",
    "mocha": "^9.2.2",
    "path-browserify": "^1.0.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.6.3",
    "url": "^0.11.0",
    "vsce": "^2.7.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:apl",
    "onDebugDynamicConfigurations:apl",
    "onCommand:extension.apl-debug.getProgramName",
    "onCommand:extension.apl-debug.help",
    "onCommand:apl.focusRepl",
    "onCommand:apl.newRepl",
    "onLanguage:apl",
    "onView:aplRepl"
  ],
  "workspaceTrust": {
    "request": "never"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "apl-repl-panel",
          "title": "APL",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "apl-repl-panel": [
        {
          "id": "aplRepl",
          "name": "APL REPL",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.apl-debug.traceBackward",
        "key": "ctrl+shift+backspace",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "extension.apl-debug.traceForward",
        "key": "ctrl+shift+enter",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "extension.apl-debug.cutback",
        "key": "escape",
        "when": "debugState == 'stopped' && !editorTextFocus"
      },
      {
        "command": "apl.escapeAction",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == 'apl'"
      },
      {
        "command": "apl.smartStepOver",
        "key": "enter",
        "when": "debugState == 'stopped' && editorTextFocus"
      },
      {
        "command": "workbench.action.debug.stepInto",
        "key": "ctrl+enter",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "extension.apl-debug.help",
        "key": "F1",
        "when": "editorTextFocus"
      },
      {
        "command": "apl.focusRepl",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "apl.goToDefinition",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == 'apl'"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "escape",
        "when": "activeWebviewPanelId == 'aplDocumentation'"
      },
      {
        "command": "apl.localizeVariable",
        "key": "ctrl+up",
        "when": "editorTextFocus && editorLangId == 'apl'"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "extension.apl-debug.traceBackward",
          "group": "1_debug",
          "when": "debugType == apl",
          "order": 1
        },
        {
          "command": "extension.apl-debug.traceForward",
          "group": "1_debug",
          "when": "debugType == apl",
          "order": 2
        },
        {
          "command": "extension.apl-debug.cutback",
          "group": "1_debug",
          "when": "debugType == apl",
          "order": 3
        }
      ],
      "editor/title/run": [
        {
          "command": "extension.apl-debug.runEditorContents",
          "when": "resourceLangId == apl",
          "group": "navigation@1"
        },
        {
          "command": "extension.apl-debug.debugEditorContents",
          "when": "resourceLangId == apl",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.apl-debug.debugEditorContents",
          "when": "resourceLangId == apl"
        },
        {
          "command": "extension.apl-debug.runEditorContents",
          "when": "resourceLangId == apl"
        }
      ],
      "debug/variables/context": [
        {
          "command": "extension.apl-debug.toggleFormatting",
          "when": "debugType == 'apl' && debugProtocolVariableMenuContext == 'simple'"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.apl-debug.debugEditorContents",
        "title": "Debug File",
        "category": "APL Debug",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      },
      {
        "command": "extension.apl-debug.runEditorContents",
        "title": "Run File",
        "category": "APL Debug",
        "enablement": "!inDebugMode",
        "icon": "$(play)"
      },
      {
        "command": "extension.apl-debug.traceBackward",
        "title": "Trace Back",
        "enablement": "inDebugMode && debugState == 'stopped'",
        "icon": "$(arrow-left)"
      },
      {
        "command": "extension.apl-debug.traceForward",
        "title": "Trace Forward",
        "enablement": "inDebugMode && debugState == 'stopped'",
        "icon": "$(arrow-right)"
      },
      {
        "command": "extension.apl-debug.cutback",
        "title": "Cutback",
        "enablement": "inDebugMode && debugState == 'stopped'",
        "icon": "$(error)"
      },
      {
        "command": "extension.apl-debug.help",
        "title": "Show help for object at current pos"
      },
      {
        "command": "extension.apl-debug.toggleFormatting",
        "title": "Toggle between decimal and hex formatting"
      },
      {
        "command": "apl.focusRepl",
        "title": "Open APL REPL",
        "category": "APL"
      },
      {
        "command": "apl.newRepl",
        "title": "New APL REPL",
        "category": "APL"
      },
      {
        "command": "apl.repl.clear",
        "title": "Clear REPL Output",
        "category": "APL"
      },
      {
        "command": "apl.repl.interrupt",
        "title": "Interrupt Execution",
        "category": "APL"
      },
      {
        "command": "apl.escapeAction",
        "title": "Close Editor or Cutback",
        "category": "APL"
      },
      {
        "command": "apl.goToDefinition",
        "title": "Go to Definition",
        "category": "APL"
      },
      {
        "command": "apl.localizeVariable",
        "title": "Localize Variable",
        "category": "APL"
      }
    ],
    "configuration": {
      "title": "APL",
      "properties": {
        "apl.connectionTiming": {
          "type": "string",
          "enum": [
            "onStart",
            "onDemand",
            "never"
          ],
          "default": "onDemand",
          "enumDescriptions": [
            "Start Dyalog APL when an APL file is opened",
            "Start Dyalog APL when the REPL is opened or code is run",
            "Never auto-start; manually connect to existing RIDE"
          ],
          "description": "When to start the Dyalog APL interpreter"
        },
        "apl.interpreter.path": {
          "type": "string",
          "default": "",
          "description": "Path to dyalog.exe. Leave empty to use 'dyalog.exe' from PATH."
        },
        "apl.ride.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host for connecting to existing RIDE session"
        },
        "apl.ride.port": {
          "type": "number",
          "default": 4502,
          "description": "Port for connecting to existing RIDE session"
        },
        "apl.backtickInput": {
          "type": "boolean",
          "default": true,
          "description": "Enable backtick prefix input for APL characters (type ` followed by a key to insert an APL glyph)"
        },
        "apl.languageBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the APL character toolbar in the REPL panel"
        }
      }
    },
    "breakpoints": [
      {
        "language": "apl"
      }
    ],
    "debuggers": [
      {
        "type": "apl",
        "languages": [
          "apl"
        ],
        "label": "APL Debug",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "exe"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to an APL file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "exe": {
                "type": "string",
                "description": "Path to dyalog executable",
                "default": "dyalog.exe"
              },
              "cwd": {
                "type": "string",
                "description": "Absolute path to a foler.",
                "default": "${workspaceFolder}"
              },
              "dyalogCfg": {
                "type": "string",
                "description": "Absolute path to a Dyalog configuration file (*.dcfg).",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              },
              "replId": {
                "type": "string",
                "description": "Internal: ID of the REPL tab to attach to."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "apl",
            "request": "launch",
            "name": "Ask for file name",
            "exe": "dyalog.exe",
            "dyalogCfg": "",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
            "internalConsoleOptions": "neverOpen"
          }
        ],
        "configurationSnippets": [
          {
            "label": "APL Debug: Launch",
            "description": "A new configuration for 'debugging' a user selected apl file.",
            "body": {
              "type": "apl",
              "request": "launch",
              "name": "Ask for file name",
              "exe": "dyalog.exe",
              "dyalogCfg": "",
              "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": true,
              "internalConsoleOptions": "neverOpen"
            }
          }
        ],
        "variables": {
          "AskForProgramName": "extension.apl-debug.getProgramName"
        }
      }
    ]
  }
}
