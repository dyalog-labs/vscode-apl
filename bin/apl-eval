#!/usr/bin/env bash
# apl-eval — client for the vscode-apl eval server
#
# Usage: apl-eval <expression>
#
# Required env:
#   APL_EVAL_TOKEN          — auth token (preferred)
#   or APL_EVAL_TOKEN_FILE  — path to a file containing the token
#                             (default: $XDG_CONFIG_HOME or ~/.config or
#                              platform-specific VS Code globalStorage path)
#
# Optional env:
#   APL_EVAL_PORT           — TCP port (default: 4502; must match
#                             `apl.evalServer.port` in VS Code settings)
#
# The token file is written by the extension to its globalStorageUri,
# typically:
#   Linux:   ~/.config/Code/User/globalStorage/<publisher>.<ext>/eval-token
#   macOS:   ~/Library/Application Support/Code/User/globalStorage/<publisher>.<ext>/eval-token
#   Windows: %APPDATA%\Code\User\globalStorage\<publisher>.<ext>\eval-token

set -u

PORT="${APL_EVAL_PORT:-4502}"
TOKEN="${APL_EVAL_TOKEN:-}"

if [ -z "$TOKEN" ] && [ -n "${APL_EVAL_TOKEN_FILE:-}" ]; then
  if [ ! -r "$APL_EVAL_TOKEN_FILE" ]; then
    echo "apl-eval: cannot read token file: $APL_EVAL_TOKEN_FILE" >&2
    exit 2
  fi
  TOKEN=$(tr -d '[:space:]' < "$APL_EVAL_TOKEN_FILE")
fi

if [ -z "$TOKEN" ]; then
  echo "apl-eval: set APL_EVAL_TOKEN or APL_EVAL_TOKEN_FILE" >&2
  exit 2
fi

if [ -z "${1:-}" ]; then
  echo "Usage: apl-eval <expression>" >&2
  exit 1
fi

exec 3<>/dev/tcp/127.0.0.1/"$PORT"
printf ']auth %s\n' "$TOKEN" >&3
IFS= read -r -d $'\0' ack <&3 || true
if [ "$ack" != "(ok)" ]; then
  echo "apl-eval: auth failed: ${ack:-<no response>}" >&2
  exec 3>&-
  exit 3
fi
printf '%s\n' "$1" >&3
IFS= read -r -d $'\0' reply <&3 || true
printf '%s' "$reply"
exec 3>&-
