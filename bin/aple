#!/usr/bin/env bash
# aple — client for the vscode-apl eval server
#
# Usage: aple <expression>
#        aple --listen
#        aple --trace <function> [breakpoint-lines...]
#
# <expression> is an APL expression, a /-meta-command, or a /debug
# command (e.g. '/debug start', '/debug next', '/debug stackTrace').
#
# --listen subscribes to DAP events from the debug session and streams
# them (one JSON object per line) until interrupted.
#
# --trace is a minimal line-by-line tracer driven purely by language
# primitives (⎕STOP to suspend, →⎕LC to resume one line), so it needs
# nothing beyond the eval server — no debug session, no editor UI.
# Stepping is step-over: calls run to completion unless the callee has
# breakpoints.
#
#   aple --trace foo        trace foo from line 1
#   aple --trace foo 3 5    run foo, stopping only at lines 3 and 5
#
# At the trace> prompt:
#   s          step one line
#   c          continue to next breakpoint (or to completion)
#   b          backtrace
#   v          names of variables visible in the suspended frame
#   l          source listing of the suspended function + current line
#   q          quit (clears stops; warns if still suspended)
#   <other>    evaluated as APL in the suspended frame
#
# Optional env:
#   APL_EVAL_PORT — TCP port (default: 4502; must match
#                   `apl.evalServer.port` in VS Code settings)
#
# The server listens on 127.0.0.1 only, and rejects any connection whose
# first bytes look like an HTTP request or TLS handshake — so browsers
# can't reach it, but any local process running as you can.

set -u

PORT="${APL_EVAL_PORT:-4502}"

# One request per connection: send a line, read the \0-terminated reply.
ask() {
  exec 3<>/dev/tcp/127.0.0.1/"$PORT" || exit 1
  printf '%s\n' "$1" >&3
  local reply=''
  IFS= read -r -d $'\0' reply <&3 || true
  printf '%s' "$reply"
  exec 3>&-
}

trace() {
  FN="${1:?usage: aple --trace <function> [breakpoint-lines...]}"; shift
  BPS="${*:-}"

  if [ "$(ask "⎕NC '$FN'")" != "3" ]; then
    echo "aple: '$FN' is not a function in the workspace" >&2
    exit 1
  fi

  finished() { [ "$(ask '≢⎕SI')" = "0" ]; }

  # Every function whose ⎕STOP we touch gets its original setting recorded
  # here (once, before the first touch) and restored on exit — a callee we
  # stepped through must not keep trace stops, nor lose the breakpoints
  # the user had on it before.
  declare -A ORIG_STOPS

  record_stops() {
    if [ -z "${ORIG_STOPS[$1]+x}" ]; then
      ORIG_STOPS[$1]="$(ask "⍕⎕STOP '$1'")"
    fi
  }

  # Idempotent: the normal exit path and the signal trap can both call it.
  STOPS_RESTORED=0
  restore_stops() {
    [ "$STOPS_RESTORED" = 1 ] && return
    STOPS_RESTORED=1
    local fn
    for fn in "${!ORIG_STOPS[@]}"; do
      ask "(${ORIG_STOPS[$fn]:-⍬}) ⎕STOP '$fn'" > /dev/null
    done
  }

  # Ctrl+C (or a kill) must not strand trace stops. The handler only flips a
  # flag — it must NOT touch the socket: restoring ⎕STOP needs a request/reply
  # round-trip, and a blocking read inside a signal handler is unreliable
  # (EINTR). Setting the flag interrupts the pending `read`, so the loop breaks
  # and restore_stops runs below in normal context, where the socket works.
  INTERRUPTED=0
  on_interrupt() { INTERRUPTED=1; }

  # ⎕STOP line numbers are always 1-based; ⍳ is not. The (1-⎕IO) offset
  # keeps the generated lines correct whatever the workspace's ⎕IO.
  all_lines() { printf '(1-⎕IO)+⍳¯1+≢⎕CR '\''%s'\''' "$1"; }

  # Arm cleanup before the first stop is installed.
  trap on_interrupt INT TERM

  # All-lines stops = tracing; explicit lines = classic breakpoints.
  record_stops "$FN"
  ask "(${BPS:-$(all_lines "$FN")}) ⎕STOP '$FN'" > /dev/null

  echo "aple: tracing $FN  (s=step c=continue b=bt v=vars l=list q=quit, else APL)"
  ask "$FN"; echo

  while ! finished; do
    [ "$INTERRUPTED" = 1 ] && break
    printf 'trace> '
    IFS= read -r cmd || break
    [ "$INTERRUPTED" = 1 ] && break
    case "$cmd" in
      s)
        cur="$(ask '⊃⎕SI')"
        record_stops "$cur"
        ask "($(all_lines "$cur")) ⎕STOP '$cur' ⋄ →⎕LC"
        ;;
      c)
        # Leave the suspended function the way the user set it up: the
        # traced function gets the requested breakpoints; a callee we
        # instrumented gets its original stops back; anything else is
        # not ours to touch.
        cur="$(ask '⊃⎕SI')"
        if [ "$cur" = "$FN" ]; then
          ask "(${BPS:-⍬}) ⎕STOP '$FN' ⋄ →⎕LC"
        elif [ -n "${ORIG_STOPS[$cur]+x}" ]; then
          ask "(${ORIG_STOPS[$cur]:-⍬}) ⎕STOP '$cur' ⋄ →⎕LC"
        else
          ask '→⎕LC'
        fi
        ;;
      b) ask "↑⎕SI{⍺,'[',⍵,']'}¨⍕¨⎕LC" ;;
      v) ask "⍕⎕NL ¯2" ;;
      l) ask "(⎕VR ⊃⎕SI),(⎕UCS 10),'   at ',(⊃⎕SI),'[',(⍕⊃⎕LC),']'" ;;
      q) break ;;
      '') continue ;;
      *) ask "$cmd" ;;
    esac
    echo
  done

  trap - INT TERM
  restore_stops
  if [ "$INTERRUPTED" = 1 ]; then
    echo >&2
    echo "aple: interrupted — trace stops restored (resume with: aple '→⎕LC', or aple ')reset')" >&2
    exit 130
  elif finished; then
    echo "aple: $FN finished"
  else
    echo "aple: quit while $(ask '⊃⎕SI') is still suspended — resume with: aple '→⎕LC'  (or aple ')reset')"
  fi
}

case "${1:-}" in
  '')
    echo "Usage: aple <expression> | aple --listen | aple --trace <fn> [lines...]" >&2
    exit 1
    ;;
  --listen)
    exec 3<>/dev/tcp/127.0.0.1/"$PORT"
    printf '/debug listen\n' >&3
    # Consume the subscription ack so stdout carries nothing but event
    # JSON — `aple --listen | jq .` must not choke on the first line.
    IFS= read -r -d $'\0' ack <&3 || exit 1
    if [ "$ack" != "[Listening]" ]; then
      echo "aple: subscription failed: $ack" >&2
      exit 1
    fi
    while IFS= read -r -d $'\0' msg <&3; do
      printf '%s\n' "$msg"
    done
    ;;
  --trace)
    shift
    trace "$@"
    ;;
  *)
    ask "$1"
    ;;
esac
